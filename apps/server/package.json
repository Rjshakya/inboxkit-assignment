{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": {
      "default": "./src/index.ts"
    },
    "./hc": {
      "default": "./src/hc.ts",
      "types": "./src/hc.ts"
    }
  },
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc -b",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.4",
    "@hono/zod-validator": "^0.8.0",
    "@inboxkit-assignment/auth": "workspace:*",
    "@inboxkit-assignment/db": "workspace:*",
    "@inboxkit-assignment/env": "workspace:*",
    "@inboxkit-assignment/game-types": "workspace:*",
    "better-auth": "catalog:",
    "better-result": "^2.9.2",
    "dotenv": "catalog:",
    "hono": "^4.12.23",
    "ioredis": "^5.11.0",
    "ws": "^8.18.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@inboxkit-assignment/config": "workspace:*",
    "@types/node": "catalog:",
    "@types/ws": "^8.18.1",
    "tsdown": "^0.21.9",
    "tsx": "^4.19.2",
    "typescript": "catalog:"
  }
}
